	)
	(text "From data sheet V_{OVLO} = 1.2V V_{UVLO} = 1.2V\n\n1. V_{IN(ON)} = V_{OVLO(R} * (R1 + R2)/R2\n\n2. V_{UVLO} = r2 + r3/ (r1 + r2 + r3) * V_{IN(UV)} \n3. V_{OVLO} = r3 / (r1 + r2 + r3) * V_{IN(OV)}\n\nV_{OV} = 13V\n\nV_{UV} = 10V\n\n1%\nr1 = 470k, r2 = 15, r3 = 47k\n\nV_{approx, OV} = 13.5V\nV_{approx, UV} = 10.3V\n\nrilm max = 464R; will give max 1.94A 845R will give 1A"
		(exclude_from_sim no)
		(at -361.95 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d55640a2-18e4-4b8b-ae41-8c86adb3bcdc")
	)
