	)
	(text "r1 = 76k8 ; r2 = 10k; vout = 6.944V ish ¯\\_(ツ)_/¯\n\nL = 7*(12V - 7)/ (12V * 0.40 * 2.5A * 1300kHz * 10^3) = 3.846uH ~= 3.8uH\n\nI_{L peak} (Min Saturation Current) = I_{LOAD} + D I_{L}/2 = 2.5A + (0.4*2.5A)/2 = 3A\nGet I_{L peak} > 3.5A\n\n"
		(exclude_from_sim no)
		(at -283.21 199.39 0)
