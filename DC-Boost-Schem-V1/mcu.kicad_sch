			)
		)
		(uuid "074be79e-a48a-4d0d-81fd-c3dd0c9cb2c0")
	)
	(text "V_{IN,UV} = V_{UVLO,F} * (R_{1}+R_{2})/R_{2}\n11V = 1.1V * (R_{1}+R_{2})/R_{2}\n11*R2 = 1.1*R1 + 1.1*R2\nR2 = 0.11*R1\n\nR2 = 1.1k\nR1 = 10k"
		(exclude_from_sim no)
		(at 490.474 184.404 0)
		(effects
