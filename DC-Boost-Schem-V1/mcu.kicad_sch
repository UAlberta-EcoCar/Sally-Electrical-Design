	(text "        V_{UVLO(F)} = (R2 + R3)/(R1 + R2 + R3) * V_{IN(UV)}\nV_{OVLO(F)} = R3/(R1 + R2 + R3) * V_{IN(OV)}\n\nV_{UVLO,F} from datasheet\n\n"
		(exclude_from_sim no)
		(at 174.498 270.002 0)
		(effects
