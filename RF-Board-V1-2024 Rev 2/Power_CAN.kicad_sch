	(text "V_{UVLO} = 1.2V, V_{OVLO} = 1.2V\n\nV_{UVLO} = V_{IN} * (R_{1} + R_{2})/(R_{1} + R_{2} + R_{3})\n\nV_{OVLO} = V_{IN} * R_{3}/(R_{1} + R_{2} + R_{3})\n\nR_{3} = 47K\n\nR_{2} = 57K\n\nR_{1} = 287K\n"
		(exclude_from_sim no)
		(at 146.558 49.276 0)
		(effects
