	(text "Total Power Consumber By Board(s) (worst case):\n\n3V3:\n	MCU: 3V3 * 150 mA * 1 =  395 mW\n	Hall Sensors: 3V3 * 5.5 mA * 20 = 363 mW\n	SSD1306 Display: 3V3 * 30 mA * 1 = 99 mW\n	I_{losses}: 3V3 * 100 mA * 1 = 330 mW\n	P_{total} = 1287 mW\n\n5V:\n	ST-Link: 5V * 10 mA * 1 = 50 mW\n	Encoder: 5V * 10 mA * 1 = 50 mW\n	I_{losses}: 5V * 40 mA * 1 = 200 mW\n	P_{total} = 300 mW\n\n12V:\n	High Gate Driver: 12V * 5 mA * 20 = 1200 mW\n	I_{losses}: 12V * 40 mA * 1 = 480 mW\n	P_{total} = 1680 mW\n\n------------------------------------\nTotal I_{out} From Each Power Level:\n\n3V3:\n	I_{out} = 1287 mW / 3V3 = 390 mA\n\n5V:\n	I_{out} = 300 mW / 5V + 390 mA = 450 mA\n\n12V:\n	I_{out} = (1680 + 450 mA * 5V) mW / 12V =  327.5 mA\n\n19V:\n	I_{out} = (1680 + 450 mA * 5V) mW / 19V = 206.84 mA"
		(exclude_from_sim no)
		(at 192.024 88.646 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f55f1d23-a34a-4a06-9186-01e3f3c8d96e")
	)
