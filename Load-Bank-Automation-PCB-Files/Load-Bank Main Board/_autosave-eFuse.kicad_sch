	(text "ILM and ITIMER Pins:\n\nLet:\nI_{LIM} = 2 A\n\nR_{ILM} (Ohm) = 3334 / I_{LIM} (A) = 1667 Ohm\n\nLet: \nt_{ITIMER} = 5 ms\n\nC_{ITIMER} (nF) = t_{ITIMER} (ms) * I_{ITIMER} (uA) / delta V_{ITIMER} (V) = 5.96 nF\n"
		(exclude_from_sim no)
		(at 196.342 122.936 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0371c7bf-3ddf-40b6-9662-ec971f370951")
	)
	(text "Notes"
		(exclude_from_sim no)
		(at 22.86 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.3556)
				(bold yes)
			)
		)
		(uuid "12cd042b-b754-41a3-bed2-d4d633c7ae9f")
	)
	(text "EN/UVLO and OVLO Pins:\n\nV_{OVLO(Rise)} = 1.2 V\nV_{UVLO(Rise)} = 1.2 V\nV_{(IN(UV)} = 14 V\nV_{IN(OV)} = 29 V\nI_{OUT_MAX} = 2 A\nt_{SS} = 25 ms\n\nLet R13 = 750k\nR_{bottom} = V_{UVLO(Rise)} * R13 / (V_{IN(UV)} - V_{UVLO(Rise)}) = 70,312.5   [EQ 1]\nR15 = 1.2 * (R13 + R_{bottom}) / V_{IN(OV)} = 33,943.97              [EQ 11]\nR14 = R_{bottom} - R15 = 36,368.53\n\nNow:\nV_{OVLO} = 1.44 V\nV_{UVLO} = 0.74 V"
		(exclude_from_sim no)
		(at 58.674 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2263a27a-850d-4ef8-8f44-2583848a0e60")
	)
	(text "e-Fuse Protection\n"
		(exclude_from_sim no)
		(at 151.638 17.272 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
				(bold yes)
			)
		)
		(uuid "4523bb0f-ed28-4e86-9701-ee747cb11d36")
	)
