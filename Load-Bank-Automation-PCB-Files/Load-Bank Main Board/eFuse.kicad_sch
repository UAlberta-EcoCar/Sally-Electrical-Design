	(text "PLIM and PDLY Pins:\n\nLet:\nI_{LIM} = 2 A\n\nR_{ILM} (Ohm) = 3334 / I_{LIM} (A) = 1667 Ohm\n\nLet: \nt_{ITIMER} = 5 ms\n\nC_{ITIMER} (nF) = t_{ITIMER} (ms) * I_{ITIMER} (uA) / delta V_{ITIMER} (V) = 5.96 nF\n"
		(exclude_from_sim no)
		(at 196.342 122.936 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0371c7bf-3ddf-40b6-9662-ec971f370951")
	)
	(text "Notes"
		(exclude_from_sim no)
		(at 22.86 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.3556)
				(bold yes)
			)
		)
		(uuid "12cd042b-b754-41a3-bed2-d4d633c7ae9f")
	)
	(text "EN/UVLO and OVLO Pins:\n\nV_{OVLO(Rise)} = 1.2 V\nV_{UVLO(Rise)} = 1.2 V\nV_{(IN(UV)} = 16 V\nV_{IN(OV)} = 30 V\nP_{OUT_MAX} = 7.5 W\nt_{SS} = 25 ms\n\nLet R13 = 750k\nR_{bottom} = V_{UVLO(Rise)} * R13 / (V_{IN(UV)} - V_{UVLO(Rise)}) = 70,312.5   [EQ 1]\nR15 = 1.2 * (R13 + R_{bottom}) / V_{IN(OV)} = 33,943.97              [EQ 11]\nR14 = R_{bottom} - R15 = 36,368.53\n\nNow:\nV_{OVLO} = 1.44 V\nV_{UVLO} = 0.74 V"
		(exclude_from_sim no)
		(at 58.674 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2263a27a-850d-4ef8-8f44-2583848a0e60")
	)
	(text "e-Fuse Protection\n"
		(exclude_from_sim no)
		(at 151.638 17.272 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
				(bold yes)
			)
		)
		(uuid "4523bb0f-ed28-4e86-9701-ee747cb11d36")
	)
	(text "- Current is limited to 2A\n- Soft Start is 141 ms\n- UVLO and OVLO range is 14 < V < 29\n- Use continuity test on the ~{FLT} pin to see if \nthe chip failed"
		(exclude_from_sim no)
		(at 20.574 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "52ff1a9a-3980-4b47-b7ed-6401d1d6ee24")
	)
	(text "eFuse"
		(exclude_from_sim no)
		(at 23.876 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "55004918-ca00-4afb-bf08-20f1b1d0bd31")
	)
	(text "dV/dt pin and C_{out}:\n\nLet:\nI_{inrush} = 100 mA\nI_{dVdT} = 2.23 uA\nG_{dVdT} = 50 V/V\nC_{out} = 470 uF\n\nSlew Rate (V/ms) = I_{inrush} (mA) / C_{out} (uF) = 0.213 V/ms\n\nC_{32} (pF) = I_{dVdT} * G_{dVdT} / Slew Rate (V/ms) = 524 nF\n\nt_{Rise} (ms) = V_{in} (V) / Slew Rate (V/ms) = 89.3 ms"
		(exclude_from_sim no)
		(at 134.874 126.238 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9ed2a2e6-8622-4aa8-bc4b-cffd6d768ec2")
	)
