//eFuse Calculations:

	//EN/UVLO and OVLO Pins
R13 = 750000  = 750,000
Rbottom = 1.2 * R13 / (14 - 1.2) = 70,312.5
R15 = 1.2 * (R13 + Rbottom) / 29 = 33,943.97
R14 = (Rbottom - R15) = 36,368.53

//Slew Rate (dV/dt pin)

	//Slew Rate (V/ms) = Iinrush (mA)/Cout (uF)
Cout = 470 = 470
Iinrush = 50 = 50
Slew_rate = Iinrush/Cout = 0.11

	//C_dv/dt (pF)= 2000/slew Rate (V/ms)
CdVdt = 2000/Slew_rate = 18,800

	//t_rise (ms) = Vin (V) / Slew_rate (V/ms)
t_rise = 15/Slew_rate = 141

	//PD_inrush (W) = Iinrush (A) * Vin (V) / 2
PD_inrush = Iinrush * 10^(-3) * 15 / 2 = 0.38


//ILM Pin

	// R_ILM (Ohm)= 3334 / I_ILM (A)

R_ILM = 3334 / 2 = 1,667

	// C_itimer (nF) = t_itimer (ms) * I_itimer (uA) / delta V_itimer (V)

C_itimer = 5 * 1.8 / 1.51 = 5.96
