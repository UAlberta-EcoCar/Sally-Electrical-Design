			)
			(justify left bottom)
		)
		(uuid "680b14de-01df-4a2c-aad5-0e08645c9e3c")
	)
	(text "Calcs for cap\nfc = 300Hz\nfc = (R1+R2)/(2*pi*R1*R2*C)\nC = 5.65uF"
