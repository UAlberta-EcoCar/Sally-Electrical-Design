	(text "When these buttons are pressed, I want power\nto the boards to stop. Therefore, power must\nbe applied to the relay to make the connection.\nWe will use the normally open (NO) contact to\ndeliver power to the boards. The emergency stop\nbuttons are then normally closed (NC)."
		(exclude_from_sim no)
		(at 130.81 56.515 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6b1bbfc2-74ae-4589-802c-4d270622f184")
	)
