#include "main.h"
#include "FreeRTOS.h"

void StartAuxilaryTask(void *argument) {
	/* USER CODE BEGIN StartAuxilaryTask */
	/* Infinite loop */
	for (;;) {
		osDelay(1);
	}
	/* USER CODE END StartAuxilaryTask */
}
